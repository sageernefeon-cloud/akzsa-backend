# Copy this file to .env and fill in your own values.
# Never commit .env or put GROQ_API_KEY inside the Android APK.
AKZSA_ENV=development
LOG_LEVEL=INFO

# Get a key from the Groq console. Keep it server-side only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# GIF / sticker search (free key from developers.giphy.com). Server-side only: never put it in the Android app.
GIPHY_API_KEY=

# Sarvam AI speech-to-text for Hindi, Hinglish and other Indian languages (key from dashboard.sarvam.ai). Server-side only.
# With a key set, Indian-language dictation uses Sarvam (Groq stays as backup and for English).
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# Hinglish output: translit = Roman letters (default) | codemix = Hindi words in Devanagari, English words in English
# SARVAM_HINGLISH_MODE=translit
# auto (default) | sarvam (Sarvam first for every language) | groq (never use Sarvam)
# AKZSA_ASR_PROVIDER=auto

# Optional during local development. Set a long random value for shared deployments.
AKZSA_SERVER_TOKEN=

# --- Abuse controls (in-memory, single instance) ---
# AKZSA_RATE_COMMANDS_PER_MIN=30
# AKZSA_RATE_COMMANDS_PER_MIN_IP=90
# AKZSA_RATE_VOICE_PER_MIN=10
# AKZSA_RATE_VOICE_PER_MIN_IP=30
# AKZSA_RATE_GIFS_PER_MIN=60
# AKZSA_RATE_GIFS_PER_MIN_IP=180
# AKZSA_MAX_CONCURRENT_PROVIDER_CALLS=8
