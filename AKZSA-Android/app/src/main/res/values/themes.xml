<resources>
    <style name="Theme.Akzsa" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/gs_light_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/gs_light_background</item>
        <item name="android:navigationBarColor">@color/gs_light_background</item>
        <item name="android:windowBackground">@color/gs_light_background</item>
    </style>
    <!-- Splash: AKZSA mark on the dark Midnight surface in both themes. -->
    <style name="Theme.Akzsa.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Akzsa</item>
    </style>
</resources>
